# Shared fallback key for Gemini only. Get a free one at https://aistudio.google.com/apikey
# OpenAI and Anthropic have no shared key — users paste their own into the Config panel per agent.
GEMINI_API_KEY=

# Postgres, hosted on Neon (neon.tech, free tier). Get both from your Neon
# project dashboard — same string, the pooled one has "-pooler" in the host.
# DATABASE_URL (pooled) is what the app queries with; DIRECT_URL (unpooled)
# is what `prisma migrate` uses to run schema changes.
DATABASE_URL="your-neon-pooled-connection-string"
DIRECT_URL="your-neon-direct-connection-string"
