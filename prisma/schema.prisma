generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// One row per agent. `data` is the full Agent record (commits, chat
// history, pinned tests, config — everything in lib/types.ts's Agent
// shape) serialized as JSON. Session-scoped instead of user-scoped: there
// are no accounts, a random cookie stands in for "your workspace."
//
// `id` is only unique WITHIN a session, not globally — every fresh session
// seeds its own copy of the same preset agents (id "resume-builder", etc),
// so two different sessions legitimately hold rows with the same `id`. The
// primary key has to be the (sessionId, id) pair, not `id` alone.
model Agent {
  id        String
  sessionId String
  name      String
  data      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([sessionId, id])
}
